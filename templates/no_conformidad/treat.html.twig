{% extends 'base.html.twig' %}

{% block title %}Tratar No Conformidad{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-header {
            background-color: #ffc107;
            color: #212529;
            font-size: 1.25rem;
            font-weight: 600;
            padding: 1rem 1.25rem;
        }
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #212529;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #212529;
        }
        .info-label {
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }
        .info-value {
            font-size: 1rem;
            color: #212529;
            margin-bottom: 0;
        }
        .info-box {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .badge {
            font-size: 0.875rem;
            padding: 0.375rem 0.75rem;
        }
        .form-group label {
            font-weight: 600;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }
        .btn-lg {
            font-size: 1.1rem;
            padding: 0.75rem 1.5rem;
        }
        .btn-warning-custom {
            background-color: #ffc107;
            color: #212529;
            border-color: #ffc107;
        }
        .btn-warning-custom:hover {
            background-color: #e0a800;
            color: #212529;
            border-color: #e0a800;
        }
        .adjuntos-button {
            display: inline-block;
        }
        .alert {
            border-radius: 0.375rem;
        }
        .form-check-label {
            font-size: 1rem;
            font-weight: 500;
        }
    </style>
{% endblock %}

{% block body %}
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                    <i class="fas fa-{% if no_conformidad.analisisAceptado is same as(false) %}edit{% else %}wrench{% endif %}"></i> 
                    {% if no_conformidad.analisisAceptado is same as(false) %}Revisar Tratamiento{% else %}Tratar{% endif %} No Conformidad #{{ no_conformidad.id }}
                </div>
                <div class="card-body">
                    <!-- Información básica -->
                    <h5 class="section-title">
                        <i class="fas fa-info-circle"></i> Información General
                    </h5>
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="info-label">ID</label>
                                <p class="info-value">#{{ no_conformidad.id }}</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="info-label">Fecha</label>
                                <p class="info-value">{{ no_conformidad.fecha|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Área</label>
                                <p class="info-value">{{ no_conformidad.area ? no_conformidad.area.nombre : 'N/A' }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Usuario que Registra</label>
                                <p class="info-value">
                                    {% if no_conformidad.creadoPor %}
                                        {% if no_conformidad.creadoPor.persona %}
                                            {{ no_conformidad.creadoPor.persona.nombre ~ ' ' ~ no_conformidad.creadoPor.persona.apellido }}
                                        {% else %}
                                            {{ no_conformidad.creadoPor.email }}
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">No disponible</span>
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Origen</label>
                                <p class="info-value">
                                    <span class="badge badge-info">
                                        {{ no_conformidad.origen|replace({'_': ' '})|title }}
                                    </span>
                                </p>
                            </div>
                                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Estado</label>
                                <p class="info-value">
                                    <span class="badge badge-{{ 
                                        no_conformidad.estado == 'nuevo' ? 'primary' :
                                        (no_conformidad.estado == 'revisado' ? 'warning' :
                                        (no_conformidad.estado == 'tratado' ? 'info' :
                                        (no_conformidad.estado == 'aceptado' ? 'success' :
                                        (no_conformidad.estado == 'desestimado' ? 'danger' : 'secondary')))) }}">
                                                    {{ no_conformidad.estado|title }}
                                                </span>
                                </p>
                            </div>
                                            </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Categoría</label>
                                <p class="info-value">
                                                <span class="badge badge-{{ no_conformidad.categoria == 'no_conformidad' ? 'danger' : 'warning' }}">
                                                    {{ no_conformidad.categoria|replace({'_': ' '})|title }}
                                                </span>
                                </p>
                                            </div>
                                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Asignado a</label>
                                <p class="info-value">
                                    {% if no_conformidad.asignadoA %}
                                        {% if no_conformidad.asignadoA.persona %}
                                            {{ no_conformidad.asignadoA.persona.apellido ~ ', ' ~ no_conformidad.asignadoA.persona.nombre }}
                                        {% else %}
                                            {{ no_conformidad.asignadoA.username|default(no_conformidad.asignadoA.email) }}
                                        {% endif %}
                                    {% else %}
                                        No asignado
                                    {% endif %}
                                </p>
                                        </div>
                                    </div>
                                    </div>
                            
                    
                    <!-- Descripción del hallazgo -->
                    <h5 class="section-title">
                        <i class="fas fa-exclamation-triangle"></i> Descripción del Hallazgo
                    </h5>
                    <div class="row mb-3">
                                            <div class="col-md-12">
                            <div class="info-box">
                                <p class="info-value">{{ no_conformidad.descripcionHallazgo }}</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Información normativa -->
                    <h5 class="section-title">
                        <i class="fas fa-book"></i> Información Normativa
                    </h5>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Norma</label>
                                <p class="info-value">{{ no_conformidad.norma|default('N/A') }}</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">PGCD</label>
                                <p class="info-value">{{ no_conformidad.pgcd ? no_conformidad.pgcd|replace({'_': ' '})|title : 'N/A' }}</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Requisito Específico</label>
                                <p class="info-value">{{ no_conformidad.requisitoEspecifico|default('N/A')|upper }}</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="info-label">Requisito Legal</label>
                                <p class="info-value">
                                    {% if no_conformidad.requisitoLegal is not null %}
                                        <span class="badge badge-{{ no_conformidad.requisitoLegal ? 'success' : 'secondary' }}">
                                            {{ no_conformidad.requisitoLegal ? 'Sí' : 'No' }}
                                        </span>
                                    {% else %}
                                        N/A
                                    {% endif %}
                                </p>
                                            </div>
                                        </div>
                                    </div>
                    {% if no_conformidad.requisitoLegal == true and no_conformidad.requisito is not empty %}
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="info-label">Requisito</label>
                                <div class="info-box">
                                    <p class="info-value">{{ no_conformidad.requisito }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    
                    <!-- Archivos adjuntos si existen -->
                    {% if no_conformidad.adjuntos|length > 0 %}
                    <h5 class="section-title">
                        <i class="fas fa-paperclip"></i> Archivos Adjuntos
                    </h5>
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="adjuntos-button">
                                <button type="button" class="btn btn-info btn-sm" data-toggle="modal" data-target="#adjuntosModal" title="Ver adjuntos">
                                    <i class="fas fa-paperclip"></i> Ver {{ no_conformidad.adjuntos|length }} archivo{{ no_conformidad.adjuntos|length > 1 ? 's' : '' }}
                                </button>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                        <!-- Formulario de tratamiento -->
                    <h5 class="section-title">
                        <i class="fas fa-clipboard-check"></i> Formulario de Tratamiento
                    </h5>
                            
                        {{ form_start(form) }}
                            
                            {% if no_conformidad.analisisAceptado is same as(false) and no_conformidad.explicacionRevisionAnalisis %}
                                <div class="alert alert-warning" role="alert">
                                    <h6><i class="fas fa-exclamation-triangle"></i> <strong>REVISIÓN SOLICITADA</strong></h6>
                                    <p class="mb-2">Se ha solicitado la revisión del análisis y/o acciones de mejora propuestas.</p>
                                    <p class="mb-0"><strong>Motivo de la revisión:</strong> {{ no_conformidad.explicacionRevisionAnalisis }}</p>
                                </div>
                            {% endif %}
                        
                        {% if no_conformidad.categoria == 'no_conformidad' %}
                            <!-- Para NO CONFORMIDAD -->
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle"></i> <strong>No Conformidad:</strong> Debe indicar si requiere análisis de causa y acción correctiva.
                                </div>
                                
                        <div class="row">
                            <div class="col-md-12">
                                        <div class="form-check mb-4">
                                            {{ form_widget(form.requiereAnalisisAccion, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(form.requiereAnalisisAccion, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                </div>
                            </div>
                        </div>

                        <div id="campos-analisis-accion" style="display: none;">
                                    <div class="alert alert-warning" role="alert">
                                        <i class="fas fa-exclamation-triangle"></i> Complete todos los campos requeridos para el análisis y acción correctiva.
                                    </div>

                            <div class="row">
                                <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(form.analisisCausa, null, {'label_attr': {'class': 'info-label'}}) }}
                                                {{ form_widget(form.analisisCausa, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                    </div>
                                </div>
                            </div>

                                <div class="row">
                                    <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(form.accionCorrectiva, null, {'label_attr': {'class': 'info-label'}}) }}
                                                {{ form_widget(form.accionCorrectiva, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                            </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.fechaAccionCorrectiva, null, {'label_attr': {'class': 'info-label'}}) }}
                                                {{ form_widget(form.fechaAccionCorrectiva, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                </div>
                            </div>
                                    </div>
                    {% else %}
                        <!-- Para OBSERVACIÓN u OPORTUNIDAD DE MEJORA -->
                                <div class="alert alert-info" role="alert">
                                    <i class="fas fa-info-circle"></i> <strong>{{ no_conformidad.categoria|replace({'_': ' '})|title }}:</strong> Puede indicar si requiere alguna acción de mejora.
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-check mb-4">
                                            {{ form_widget(form.requiereCorreccionMejora, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(form.requiereCorreccionMejora, null, {'label_attr': {'class': 'form-check-label'}}) }}
                                </div>
                            </div>
                        </div>

                        <div id="campos-correccion-mejora" style="display: none;">
                                    <div class="alert alert-warning" role="alert">
                                        <i class="fas fa-lightbulb"></i> Describa la acción de mejora propuesta.
                                    </div>
                                    
                            <div class="row">
                                <div class="col-md-12">
                                            <div class="form-group">
                                                {{ form_label(form.correccion, null, {'label_attr': {'class': 'info-label'}}) }}
                                                {{ form_widget(form.correccion, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                    </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.fechaCorreccion, null, {'label_attr': {'class': 'info-label'}}) }}
                                                {{ form_widget(form.fechaCorreccion, {'attr': {'class': 'form-control'}}) }}
                                            </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                        
                        <div class="row mt-4">
                            <div class="col-md-12">
                                    <button type="submit" class="btn btn-warning-custom btn-lg">
                                        <i class="fas fa-save"></i> Guardar Tratamiento
                            </button>
                                    <a href="{{ path('no_conformidad_index') }}" class="btn btn-secondary btn-lg">
                                        <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para archivos adjuntos -->
    {% if no_conformidad.adjuntos|length > 0 %}
        <div class="modal fade" id="adjuntosModal" tabindex="-1" role="dialog" aria-labelledby="adjuntosModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title" id="adjuntosModalLabel">
                            <i class="fas fa-paperclip"></i> Archivos Adjuntos - No Conformidad #{{ no_conformidad.id }}
                        </h5>
                        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Nombre del Archivo</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for adjunto in no_conformidad.adjuntos %}
                                        <tr>
                                            <td>{{ loop.index }}</td>
                                            <td>
                                                <i class="fas fa-file-pdf text-danger"></i> 
                                                {{ adjunto.nombreOriginal|default('Archivo ' ~ loop.index) }}
                                            </td>
                                            <td>
                                                <a href="{{ vich_uploader_asset(adjunto, 'archivoFile') }}" 
                                                   class="btn btn-sm btn-primary" 
                                                   target="_blank">
                                                    <i class="fas fa-download"></i> Descargar
                                                </a>
                                                <a href="{{ vich_uploader_asset(adjunto, 'archivoFile') }}" 
                                                   class="btn btn-sm btn-info" 
                                                   target="_blank">
                                                    <i class="fas fa-eye"></i> Ver
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">
                            <i class="fas fa-times"></i> Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Script cargado'); // Debug
            
            // Para NO CONFORMIDAD - nuevo nombre del checkbox
            const requiereAnalisisAccion = document.querySelector('input[name*="requiereAnalisisAccion"]');
            const camposAnalisisAccion = document.getElementById('campos-analisis-accion');
            
            if (requiereAnalisisAccion) {
                console.log('Checkbox NO CONFORMIDAD encontrado'); // Debug
                requiereAnalisisAccion.addEventListener('change', function() {
                    console.log('Checkbox NO CONFORMIDAD cambiado:', this.checked); // Debug
                    if (this.checked) {
                        camposAnalisisAccion.style.display = 'block';
                    } else {
                        camposAnalisisAccion.style.display = 'none';
                    }
                });
            } else {
                console.log('Checkbox NO CONFORMIDAD no encontrado'); // Debug
            }
            
            // Para OBSERVACIÓN u OPORTUNIDAD DE MEJORA
            const requiereCorreccionMejora = document.querySelector('input[name*="requiereCorreccionMejora"]');
            const camposCorreccionMejora = document.getElementById('campos-correccion-mejora');
            
            if (requiereCorreccionMejora) {
                console.log('Checkbox OBSERVACIÓN encontrado'); // Debug
                requiereCorreccionMejora.addEventListener('change', function() {
                    console.log('Checkbox OBSERVACIÓN cambiado:', this.checked); // Debug
                    if (this.checked) {
                        camposCorreccionMejora.style.display = 'block';
                    } else {
                        camposCorreccionMejora.style.display = 'none';
                    }
                });
            } else {
                console.log('Checkbox OBSERVACIÓN no encontrado'); // Debug
            }
            
            // Listar todos los inputs para debug
            const allInputs = document.querySelectorAll('input[type="checkbox"]');
            console.log('Todos los checkboxes encontrados:', allInputs);
            allInputs.forEach(input => {
                console.log('Checkbox:', input.name, input.id);
            });
        });
    </script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
{% endblock %} 