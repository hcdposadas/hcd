{% extends 'base.html.twig' %}

{% block title %}Verificar Efectividad - No Conformidad{% endblock %}

{% block body %}
    <style>
        .card-header {
            background-color: #6c757d;
            color: white;
            font-size: 1.25rem;
            font-weight: 600;
            padding: 1rem 1.25rem;
        }
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #212529;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #212529;
        }
        .info-label {
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }
        .info-value {
            font-size: 1rem;
            color: #212529;
            margin-bottom: 0;
        }
        .info-box {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .badge {
            font-size: 0.875rem;
            padding: 0.375rem 0.75rem;
        }
        .form-group label {
            font-weight: 600;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.5rem;
        }
        .btn-lg {
            font-size: 1.1rem;
            padding: 0.75rem 1.5rem;
        }
        .btn-gray-custom {
            background-color: #6c757d;
            color: white;
            border-color: #6c757d;
        }
        .btn-gray-custom:hover {
            background-color: #545b62;
            color: white;
            border-color: #545b62;
        }
        .adjuntos-button {
            display: inline-block;
        }
        .alert {
            border-radius: 0.375rem;
        }
        .form-check-label {
            font-size: 1rem;
            font-weight: 500;
        }
        .form-control {
            font-size: 1rem;
        }
        label {
            font-size: 0.95rem;
            font-weight: 600;
        }
        .info-text {
            font-size: 1.15rem;
            line-height: 1.6;
            color: #212529;
            background-color: #f8f9fa;
            padding: 1rem;
            border-radius: 0.25rem;
            border: 1px solid #dee2e6;
        }
    </style>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-check-double"></i> Verificar Efectividad - No Conformidad #{{ no_conformidad.id }}
                </div>
                <div class="card-body">
                    <!-- Información básica -->
                    <h5 class="section-title">
                        <i class="fas fa-info-circle"></i> Información General
                    </h5>
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="info-label">ID</label>
                                <p class="info-value">#{{ no_conformidad.id }}</p>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="info-label">Fecha</label>
                                <p class="info-value">{{ no_conformidad.fecha|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Área</label>
                                <p class="info-value">{{ no_conformidad.area ? no_conformidad.area.nombre : 'N/A' }}</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Estado</label>
                                <p class="info-value">
                                    <span class="badge badge-{{ 
                                        no_conformidad.estado == 'nuevo' ? 'primary' :
                                        (no_conformidad.estado == 'revisado' ? 'warning' :
                                        (no_conformidad.estado == 'tratado' ? 'info' :
                                        (no_conformidad.estado == 'aceptado' ? 'success' :
                                        (no_conformidad.estado == 'desestimado' ? 'danger' : 'secondary')))) }}">
                                        {{ no_conformidad.estado|title }}
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen del tratamiento y corrección -->
                    <h5 class="section-title">
                        <i class="fas fa-clipboard-list"></i> Resumen del Proceso
                    </h5>
                            
                    <div class="row mb-3">
                        <div class="col-md-4">
                                            <div class="form-group">
                                <label class="info-label">Corrección Verificada</label>
                                <p class="info-value">
                                                    {% if no_conformidad.correccionVerificada is not null %}
                                                        <span class="badge badge-{{ no_conformidad.correccionVerificada ? 'success' : 'danger' }}">
                                                            {{ no_conformidad.correccionVerificada ? 'Sí' : 'No' }}
                                                        </span>
                                                    {% else %}
                                                        <span class="badge badge-secondary">No verificada</span>
                                                    {% endif %}
                                                </p>
                                            </div>
                                        </div>
                        {% if no_conformidad.fechaCorreccion %}
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Fecha de Corrección</label>
                                <p class="info-value">{{ no_conformidad.fechaCorreccion|date('d/m/Y') }}</p>
                            </div>
                        </div>
                        {% endif %}
                        {% if no_conformidad.fechaAccionCorrectiva %}
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="info-label">Fecha de Acción Correctiva</label>
                                <p class="info-value">{{ no_conformidad.fechaAccionCorrectiva|date('d/m/Y') }}</p>
                            </div>
                        </div>
                        {% endif %}
                                    </div>
                            
                    {% if no_conformidad.correccion %}
                    <div class="row mb-3">
                                        <div class="col-md-12">
                                            <div class="form-group">
                                <label class="info-label">Corrección Aplicada</label>
                                <div class="info-box">
                                    <p class="info-value">{{ no_conformidad.correccion }}</p>
                                </div>
                                            </div>
                                        </div>
                                    </div>
                    {% endif %}

                    {% if no_conformidad.accionCorrectiva %}
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="info-label">Acción Correctiva</label>
                                <div class="info-box">
                                    <p class="info-value">{{ no_conformidad.accionCorrectiva }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                            
                    {% if no_conformidad.analisisCausa %}
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="info-label">Análisis de Causa</label>
                                <div class="info-box">
                                    <p class="info-value">{{ no_conformidad.analisisCausa }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Formulario de verificación de efectividad -->
                    <h5 class="section-title">
                        <i class="fas fa-check-double"></i> Verificación de Efectividad
                    </h5>
                            
                    {{ form_start(form) }}
                            
                            <div class="alert alert-info mb-4">
                                <i class="fas fa-info-circle"></i> <strong>Importante:</strong> 
                                La verificación de efectividad confirma que las acciones correctivas implementadas han sido efectivas 
                                para prevenir la recurrencia de la no conformidad.
                            </div>
                            
                            <div class="form-group mb-4">
                                {{ form_label(form.efectividadVerificada, null, {'label_attr': {'class': 'info-label'}}) }}
                                <div class="mt-3">
                                    {% for choice in form.efectividadVerificada %}
                                        <div class="form-check mb-2">
                                            {{ form_widget(choice, {'attr': {'class': 'form-check-input verificacion-radio'}}) }}
                                            {{ form_label(choice, null, {'label_attr': {'class': 'form-check-label ' ~ (choice.vars.value == '1' ? 'text-success' : 'text-warning')}}) }}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            
                            <div class="form-group mb-4">
                                {{ form_label(form.comentariosVerificacion, null, {'label_attr': {'class': 'info-label'}}) }}
                                {{ form_widget(form.comentariosVerificacion, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            </div>
                            
                            <div id="nueva-fecha-container" style="display: none;">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle"></i> Al seleccionar NO, debe proporcionar una nueva fecha para verificar la efectividad.
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.nuevaFechaEfectividad, null, {'label_attr': {'class': 'info-label'}}) }}
                                    {{ form_widget(form.nuevaFechaEfectividad, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    
                            <div id="si-container" style="display: none;">
                                <div class="alert alert-success">
                                    <i class="fas fa-check-circle"></i> Al confirmar, la no conformidad será marcada como <strong>VERIFICADA EFECTIVIDAD/CERRADO</strong> definitivamente.
                                </div>
                                <div class="form-group mt-3">
                                    <label class="info-label">
                                        Fecha de Cierre
                                    </label>
                                    <input type="date" 
                                           id="fecha-cierre" 
                                           class="form-control" 
                                           readonly 
                                           style="background-color: #e9ecef; cursor: not-allowed;">
                                    <small class="form-text text-muted">
                                        Se asignará automáticamente la fecha de hoy al confirmar la verificación de efectividad.
                                    </small>
                        </div>
                    </div>
                    
                            <!-- Botones -->
                            <div class="row mt-5">
                        <div class="col-md-12">
                                    <button type="submit" class="btn btn-gray-custom btn-lg mr-2">
                                        <i class="fas fa-save"></i> GUARDAR VERIFICACIÓN
                            </button>
                                    <a href="{{ path('no_conformidad_index') }}" class="btn btn-secondary btn-lg">
                                        <i class="fas fa-arrow-left"></i> Volver
                            </a>
                        </div>
                    </div>
                            
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const radioButtons = document.querySelectorAll('.verificacion-radio');
            const nuevaFechaContainer = document.getElementById('nueva-fecha-container');
            const siContainer = document.getElementById('si-container');
            const fechaCierre = document.getElementById('fecha-cierre');
            
            // Función para obtener la fecha actual en formato YYYY-MM-DD
            function getFechaActual() {
                const hoy = new Date();
                const año = hoy.getFullYear();
                const mes = String(hoy.getMonth() + 1).padStart(2, '0');
                const dia = String(hoy.getDate()).padStart(2, '0');
                return `${año}-${mes}-${dia}`;
            }
            
            function toggleContainers() {
                // Buscar el radio button seleccionado
                const radioSi = document.querySelector('input[name*="efectividadVerificada"][value="1"]:checked');
                const radioNo = document.querySelector('input[name*="efectividadVerificada"][value="0"]:checked');
                
                if (radioNo) {
                    nuevaFechaContainer.style.display = 'block';
                    siContainer.style.display = 'none';
                } else if (radioSi) {
                    nuevaFechaContainer.style.display = 'none';
                    siContainer.style.display = 'block';
                    // Establecer la fecha actual
                    if (fechaCierre) {
                        fechaCierre.value = getFechaActual();
                    }
                } else {
                    nuevaFechaContainer.style.display = 'none';
                    siContainer.style.display = 'none';
                }
            }
            
            radioButtons.forEach(function(radio) {
                radio.addEventListener('change', toggleContainers);
            });
            
            // Verificar estado inicial
            toggleContainers();
        });
    </script>
{% endblock %} 