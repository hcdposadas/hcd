{% extends 'base.html.twig' %}

{% macro mostrarTicketsRelacionados(tickets, nivel) %}
    {% import _self as macros %}
    {% if tickets and tickets|length > 0 %}
        <ul class="list-unstyled ml-{{ nivel * 3 }}">
            {% for ticketRelacionado in tickets %}
                <li>
                    <a href="#" class="badge badge-info" data-toggle="modal" data-target="#ticketModal-{{ ticketRelacionado.id }}">
                        #{{ ticketRelacionado.id }} - {{ ticketRelacionado.texto|length > 30 ? ticketRelacionado.texto|slice(0, 30) ~ '...' : ticketRelacionado.texto }}
                    </a>
                    
                    <!-- Modal para mostrar el ticket -->
                    <div class="modal fade" id="ticketModal-{{ ticketRelacionado.id }}" tabindex="-1" role="dialog" aria-labelledby="ticketModalLabel-{{ ticketRelacionado.id }}" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="ticketModalLabel-{{ ticketRelacionado.id }}">Ticket #{{ ticketRelacionado.id }}</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <dl class="row">
                                        <dt class="col-sm-3">Descripción:</dt>
                                        <dd class="col-sm-9">{{ ticketRelacionado.texto }}</dd>
                                        
                                        <dt class="col-sm-3">Área Origen:</dt>
                                        <dd class="col-sm-9">{{ ticketRelacionado.areaOrigen }}</dd>
                                        
                                        <dt class="col-sm-3">Área Destino:</dt>
                                        <dd class="col-sm-9">{{ ticketRelacionado.areaDestino }}</dd>
                                        
                                        <dt class="col-sm-3">Fecha:</dt>
                                        <dd class="col-sm-9">{{ ticketRelacionado.fecha | date('d/m/Y H:i') }}</dd>
                                        
                                        <dt class="col-sm-3">Estado:</dt>
                                        <dd class="col-sm-9">
                                            {% if ticketRelacionado.completo %}
                                                Completo
                                            {% elseif ticketRelacionado.observacion == 'Cancelado' %}
                                                Cancelado
                                            {% elseif ticketRelacionado.completo is same as(false) %}
                                                Rechazado
                                            {% else %}
                                                Pendiente
                                            {% endif %}
                                        </dd>
                                        
                                        {% if ticketRelacionado.observacion %}
                                        <dt class="col-sm-3">Observación:</dt>
                                        <dd class="col-sm-9">{{ ticketRelacionado.observacion }}</dd>
                                        {% endif %}
                                        
                                        {% if ticketRelacionado.adjuntoNombre %}
                                        <dt class="col-sm-3">Adjunto:</dt>
                                        <dd class="col-sm-9">
                                            <a href="{{ vich_uploader_asset(ticketRelacionado, 'adjuntoFile') }}" target="_blank" class="btn btn-sm btn-info">
                                                <i class="fa fa-paperclip"></i> Ver adjunto
                                            </a>
                                        </dd>
                                        {% endif %}
                                    </dl>
                                </div>
                                <div class="modal-footer">
                                    <a href="{{ path('ticket_seguimiento', {'ticket': ticketRelacionado.id}) }}" class="btn btn-primary">
                                        <i class="fa fa-sitemap"></i> Ver seguimiento completo
                                    </a>
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {% if ticketRelacionado.ticketsRelacionados and ticketRelacionado.ticketsRelacionados|length > 0 %}
                        {{ macros.mostrarTicketsRelacionados(ticketRelacionado.ticketsRelacionados, nivel + 1) }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% block title %}
    Ticket De Servicio
{% endblock title %}

{% block body %}
    {% import _self as macros %}

    <div class="row">
        <div class="col-md-12">
            <div class="card collapsed-card">
                <div class="card-header">
                    <h3 class="card-title">Filtros</h3>
                    <div class="card-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-card-widget="collapse"><i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                {{ form_start(filter_type) }}
                <div class="row">
                        <div style="width:40%">
                            {{ form_row(filter_type.texto) }}</div>
                            <div style="width:100%">
                            <b>Área de Origen</b>
                            </div>
                            <div style="width:100%">
                            {{ form_widget(filter_type.areaOrigen) }}
                            </div>
                            <div class="col-md-2">           
                            {{ form_row(filter_type.fecha) }}
                            </div>
                    </div>
                </div>
                <div class="card-footer">
                    {{ form_widget(filter_type.buscar) }}
<button type="submit" name="reset" class="btn btn-default">Limpiar</button>
                </div>
                <div class="d-none">
                    {{ form_end(filter_type) }}
                </div>
            </div>
        </div>
    </div> 

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Tickets De Servicio Recibidos</h3>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped data-table">
                        <thead>
                        <tr>
                            <th>Id</th>
                            <th>Área De Destino</th>
                            <th class="col-md-4">Ticket</th>
                            <th>Área De Origen</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="col-md-2">Observación</th>
                            <th>Acción</th>
                        </tr>
                        </thead>
                        <tbody>
                        

{% set sortedTickets = tickets|sort((a, b) => b.id <=> a.id) %}

{% for ticket in sortedTickets %}
                            <tr>
                                <td>
                                    {{ ticket.id }}
                                </td>
<td>{{ ticket.areaDestino }}</td>
                                <td>{{ ticket.texto }}
                                {% if ticket.adjuntoNombre %}
                                    <br><a href="{{ vich_uploader_asset(ticket, 'adjuntoFile') }}" target="_blank" class="text-primary">
                                        <i class="fa fa-paperclip"></i> Ver adjunto
                                    </a>
                                {% endif %}
                                {% if ticket.ticketPadre %}
                                    <br><span class="text-info">
                                        <i class="fa fa-link"></i> Relacionado con: 
                                        <a href="#" class="badge badge-primary" data-toggle="modal" data-target="#ticketRelacionadoModal-{{ ticket.ticketPadre.id }}">
                                            Ticket #{{ ticket.ticketPadre.id }}
                                        </a>
                                    </span>
                                    
                                    <!-- Modal para mostrar el ticket relacionado -->
                                    <div class="modal fade" id="ticketRelacionadoModal-{{ ticket.ticketPadre.id }}" tabindex="-1" role="dialog" aria-labelledby="ticketRelacionadoModalLabel-{{ ticket.ticketPadre.id }}" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="ticketRelacionadoModalLabel-{{ ticket.ticketPadre.id }}">Ticket Relacionado #{{ ticket.ticketPadre.id }}</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <dl class="row">
                                                        <dt class="col-sm-3">Descripción:</dt>
                                                        <dd class="col-sm-9">{{ ticket.ticketPadre.texto }}</dd>
                                                        
                                                        <dt class="col-sm-3">Área Origen:</dt>
                                                        <dd class="col-sm-9">{{ ticket.ticketPadre.areaOrigen }}</dd>
                                                        
                                                        <dt class="col-sm-3">Área Destino:</dt>
                                                        <dd class="col-sm-9">{{ ticket.ticketPadre.areaDestino }}</dd>
                                                        
                                                        <dt class="col-sm-3">Fecha:</dt>
                                                        <dd class="col-sm-9">{{ ticket.ticketPadre.fecha | date('d/m/Y H:i') }}</dd>
                                                        
                                                        <dt class="col-sm-3">Estado:</dt>
                                                        <dd class="col-sm-9">
                                                            {% if ticket.ticketPadre.completo %}
                                                                Completo
                                                            {% elseif ticket.ticketPadre.observacion == 'Cancelado' %}
                                                                Cancelado
                                                            {% elseif ticket.ticketPadre.completo is same as(false) %}
                                                                Rechazado
                                                            {% else %}
                                                                Pendiente
                                                            {% endif %}
                                                        </dd>
                                                        
                                                        {% if ticket.ticketPadre.observacion %}
                                                        <dt class="col-sm-3">Observación:</dt>
                                                        <dd class="col-sm-9">{{ ticket.ticketPadre.observacion }}</dd>
                                                        {% endif %}
                                                        
                                                        {% if ticket.ticketPadre.adjuntoNombre %}
                                                        <dt class="col-sm-3">Adjunto:</dt>
                                                        <dd class="col-sm-9">
                                                            <a href="{{ vich_uploader_asset(ticket.ticketPadre, 'adjuntoFile') }}" target="_blank" class="btn btn-sm btn-info">
                                                                <i class="fa fa-paperclip"></i> Ver adjunto
                                                            </a>
                                                        </dd>
                                                        {% endif %}
                                                    </dl>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                                
                                {% if ticket.ticketsRelacionados.count > 0 %}
                                    <br><span class="text-primary">
                                        <i class="fa fa-sitemap"></i> Tickets relacionados:
                                    </span>
                                    {{ macros.mostrarTicketsRelacionados(ticket.ticketsRelacionados, 1) }}
                                {% endif %}
                                
                                {% if ticket.ticketsRelacionados.count > 0 or ticket.ticketPadre %}
                                    <br>
                                    <a href="{{ path('ticket_seguimiento', {'ticket': ticket.id}) }}" class="btn btn-sm btn-primary mt-2">
                                        <i class="fa fa-sitemap"></i> Ver seguimiento completo
                                    </a>
                                {% endif %}
                                </td>
                                <td>{{ ticket.areaOrigen }}</td>
                                <td><i class="fa  fa-arrow-right"></i>{{ ticket.fecha | date('d/m/Y H:i') }}  {% if ticket.fechaV %} <br/> <i class="fa fa-eye"></i> {{ticket.fechaV | date('d/m/Y H:i') }}{% endif %}
                                 {% if ticket.fechaC %}
                                 {% if ticket.completo  %} <br/>  <i class="fa fa-check"></i> 
                                 {% else %} 
                                 <br/> <i class="fa fa-fw fa-trash"></i>
                                 {% endif %} 
                                 {{ ticket.fechaC | date('d/m/Y H:i')  }}
                                 {% endif %}</td>
                                <td> {% if ticket.completo  %}
                                    Completo{% if ticket.confirmado == true %}
                                    <svg xmlns="http://www.w3.org/2000/svg" height="12" width="12" viewBox="0 0 512 512"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="#63E6BE" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512z"/></svg>

                                            {% elseif ticket.confirmado is same as  (false) %}
                                                                                <svg xmlns="http://www.w3.org/2000/svg" height="12" width="12" viewBox="0 0 512 512"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="#da1616" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512z"/></svg>

                                            {% endif %}
                                                                {% elseif ticket.observacion == 'Cancelado' %}
                                    Cancelado
                                {% elseif ticket.completo is same as  (false) %}
                                        Rechazado
                                    {% elseif ticket.completo == null %}
                                        Pendiente
                                        {% if ticket.abierto == false  %}
                                    <svg xmlns="http://www.w3.org/2000/svg" height="12" width="12" viewBox="0 0 512 512"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="#da1616" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512z"/></svg>
                                    {% else  %}
                                    <svg xmlns="http://www.w3.org/2000/svg" height="12" width="12" viewBox="0 0 512 512"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="#63E6BE" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512z"/></svg>
                                    
                                    {% endif %} 
                                
                                    {% endif %}    
                                        </td>
                                <td>
                                        {{ticket.observacion}}
 
                                        </td>
                               

                                <td>
                                    {% if ticket.observacion == null %}

                                    {% if ticket.abierto == true %}
                                    <a class="btn btn-default"
                                       href="{{ path('ticket_close', { 'id': ticket.id }) }}">
                                        <i class="fa fa-check"></i>
                                    </a>
                                    <a class="btn btn-default"
                                       href="{{ path('ticket_reject', { 'id': ticket.id }) }}">
                                       <i class="fa fa-fw fa-trash"></i>
                                    </a>
                                    <a class="btn btn-default"
                                       href="{{ path('ticket_new_related', { 'ticket': ticket.id }) }}" 
                                       title="Crear ticket relacionado">
                                        <i class="fa fa-link"></i>
                                    </a>
                                    {% else %}
                                    <a class="btn btn-default"
                                       href="{{ path('ticket_accepted', { 'id': ticket.id }) }}">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                     {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {# display navigation #}
    <div class="col-md-12 text-center">
        <div class="navigation">
        {% if tickets %}
            {{ knp_pagination_render(tickets) }}
        {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
{% endblock javascripts %}
