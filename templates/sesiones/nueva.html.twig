{% extends 'base.html.twig' %}

{% block title %}
    Nueva Sesión
{% endblock title %}

{% block body %}
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Crear Nueva Sesión</h3>
                </div>
                {{ form_start(form) }}
                <div class="card-body">
                    <div class="form-group">
                        {{ form_label(form.titulo) }}
                        {{ form_widget(form.titulo) }}
                        {{ form_errors(form.titulo) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.fecha) }}
                        {{ form_widget(form.fecha) }}
                        {{ form_errors(form.fecha) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.tipoSesion) }}
                        {{ form_widget(form.tipoSesion) }}
                        {{ form_errors(form.tipoSesion) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.numeroReunion) }}
                        {{ form_widget(form.numeroReunion) }}
                        {{ form_errors(form.numeroReunion) }}
                    </div>
                    <div class="callout callout-warning">
                        <h5>Importante</h5>
                        <p>Al crear esta nueva sesión, todas las sesiones activas serán desactivadas automáticamente.</p>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Crear Sesión
                    </button>
                    <a href="{{ path('sesiones_conformar_plan_de_labor_index') }}" class="btn btn-default">
                        Cancelar
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock body %}