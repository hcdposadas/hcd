<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{ title }}</title>
    <style>
        * {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12pt;
        }

        .giro {
            width: 100%;
        }

        .punteado {
            width: 96%;
            margin-left: 4%;
            text-align: center;
            border-bottom: 2px dotted black;
        }

        section {
            width: 100%;
            margin: auto;
            padding: 5px;
        }

        div#one {
            width: 30%;
            float: left;
        }

        div#two {
            margin-left: 30%;
            width: 70%;
            border-bottom: 2px dotted black;
        }

        div#tres {
            width: 80%;
        }

        div#cuatro {
            margin-left: 75%;
            width: 25%;
            border-bottom: 2px dotted black;
        }

        div#cinco {
            width: 10%;
        }

        div#seis {
            margin-left: 10%;
            border-bottom: 2px dotted black;
        }


    </style>
</head>
<body>
<section>
        <div class="row" style="float: left; text-align: center; margin-left: 0%">
            <img style="max-width: 100%;height: 3cm"
             src="{{ absolute_url(asset('uploads/sis_images/escudo.png')) }}" alt="escudo"> 
            <div style="font-weight: bold;">     
            Honorable Concejo Deliberante</br>
            Dirección de Asuntos</br>
            Legislativos y Comisiones
            </div>
        </div>
</section>
<section>
    <div style="font-weight: bold;text-align: center;margin-top:250px; font-size:1.75em">PASE A COMISIÓN</div>
</section>
<section>
                    <div style="text-align: right;margin-top:50px">
                        <p style="font-weight: bold;font-size:1.5em;text-decoration: underline;">EXPTE. Nº {{ expediente.expediente }}-{{expediente.letra}}-{{expediente.periodoLegislativo.anio}}</p>
                        
                    </div>
<div style="font-size:1.5em;text-indent: 12em;">
De acuerdo con lo dispuesto en la <b style="font-size:1em">{{ sesion.titulo }}</b> del día {{ sesion.fecha|date('d/m/Y') }}, pase el presente Expediente a
{% if giros|length == 1 %}
    la <b>Comisión</b> de <b style="font-size:1em">{{ giros[0].comisionDestino.nombre|slice(9) }}</b>
{% elseif giros|length > 1 %}
    las <b>Comisiones</b>
    {% for giro in giros %}
        {% if loop.last %}
            y 
        {% elseif not loop.first %}
            , 
        {% endif %}
        <b style="font-size:1em">{{ giro.comisionDestino.nombre|slice(9) }}</b>
    {% endfor %}
{% endif %}
a su consideración.-
</div>
</section>

</body>
</html>