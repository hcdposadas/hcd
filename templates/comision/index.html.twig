{% extends 'base.html.twig' %}
{% block title %}
    Proyectos Girados
{% endblock title %}
{% block body %}
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Filtrar por Expediente</h3>
                </div>
                <div class="card-body">
                    <form method="get" action="{{ path('comision_index') }}" class="form-inline">
                        <div class="form-group mx-sm-3 mb-2">
                            <label for="numero" class="mr-2">Número:</label>
                            <input type="number" class="form-control" id="numero" name="numero" value="{{ numero }}">
                        </div>
                        <div class="form-group mx-sm-3 mb-2">
                            <label for="letra" class="mr-2">Letra:</label>
                            <input type="text" class="form-control" id="letra" name="letra" value="{{ letra }}">
                        </div>
                        <div class="form-group mx-sm-3 mb-2">
                            <label for="anio" class="mr-2">Año:</label>
                            <input type="number" class="form-control" id="anio" name="anio" value="{{ anio }}">
                        </div>
                        <div class="form-group mx-sm-3 mb-2">
                            <label for="fecha" class="mr-2">Fecha:</label>
                            <input type="date" class="form-control" id="fecha" name="fecha" value="{{ fecha }}">
                        </div>
                        {% if 'obras' in app.user.persona.cargoPersona.first.comision.nombre|lower %}

                            <div class="form-group mx-sm-3 mb-2">
                                <label for="estado_giro" class="mr-2">Estado:</label>
                                <select class="form-control" id="estado_giro" name="estado_giro">
                                    <option value="todos"
                                            {% if estado_giro == 'todos' or not estado_giro %}selected{% endif %}>Todos
                                    </option>
                                    <option value="solo_cabecera"
                                            {% if estado_giro == 'solo_cabecera' %}selected{% endif %}>Solo giros
                                        cabecera
                                    </option>
                                    <option value="en_tratamiento"
                                            {% if estado_giro == 'en_tratamiento' %}selected{% endif %}>En tratamiento
                                    </option>
                                    <option value="finalizados"
                                            {% if estado_giro == 'finalizados' %}selected{% endif %}>Finalizados
                                    </option>
                                </select>
                            </div>
                        {% endif %}

                        <button type="submit" class="btn btn-primary mb-2">Filtrar</button>
                        <a href="{{ path('comision_index') }}" class="btn btn-secondary mb-2 ml-2">Limpiar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Giros A Comisión</h3>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped data-table">
                        <thead>
                        <tr>

                            <th>Id</th>
                            <th>Expediente</th>
                            <th>Fecha</th>
                            {% if is_granted('ROLE_LEGISLATIVO') %}
                                <th style="width:30%">Extracto</th>
                            {% else %}
                                <th>Último Giro</th>
                            {% endif %}
                            <th>Iniciador</th>
                            <th>Acción</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for giro in giros %}
                            {% if giro.proyectoBae %}
                                <tr>
                                    <td>
                                        <a href="{{ path('expediente_show', { 'id': giro.proyectoBae.expediente.id }) }}">{{ giro.id }}</a>
                                    </td>
                                    <td>{{ giro.proyectoBae.expediente.expediente }}
                                        -{{ giro.proyectoBae.expediente.letra }}
                                        -{% if giro.proyectoBae.expediente.periodoLegislativo %}{{ giro.proyectoBae.expediente.periodoLegislativo }}{% else %}{{ giro.proyectoBae.expediente.anio }}{% endif %}</td>

                                    <td>{% if giro.proyectoBae.expediente.fecha %}{{ giro.proyectoBae.expediente.fecha|date('d/m/Y') }}{% endif %}</td>
                                    {% if is_granted('ROLE_LEGISLATIVO') %}
                                        <td>{{ giro.proyectoBae.expediente.extracto }}</td>
                                    {% else %}
                                        <td>{{ ultimosGiros[giro.proyectoBae.expediente.id]|default('Sin giro administrativo') }}</td>
                                    {% endif %}
                                    <td>
                                        {% if giro.proyectoBae.expediente.iniciadores.count > 0 %}
                                            {% for iniciadorExpediente in giro.proyectoBae.expediente.iniciadores %}
                                                {% if iniciadorExpediente.iniciador %}
                                                    {{ iniciadorExpediente.iniciador.cargoPersona | title }} -
                                                {% endif %}
                                            {% endfor %}
                                        {% elseif giro.proyectoBae.expediente.iniciadorParticular %}
                                            {{ giro.proyectoBae.expediente.iniciadorParticular.nombreCompleto }}
                                        {% elseif giro.proyectoBae.expediente.dependencia %}
                                            {{ giro.proyectoBae.expediente.dependencia }}
                                        {% endif %}
                                    </td>

                                    <td>
                                        <a class="btn btn-default" data-toggle="tooltip" title="Ver Expediente"
                                           href="{{ path('comision_show_proyecto', { 'id': giro.id }) }}">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a class="btn btn-default" data-toggle="tooltip" title="Seguimiento"
                                           href="{{ path('expediente_timeline', {id: giro.proyectoBae.expediente.id}) }}">
                                            <i class="fas fa-road"></i>
                                        </a>

                                        {% set cantidadGiros = giro.proyectoBae.giros|length %}
                                        {% if (cantidadGiros == 1 or giro.cabecera) and not is_granted('ROLE_CONCEJAL') %}
                                            {% if habilitado %}
                                                <a class="btn btn-default" data-toggle="tooltip"
                                                   title="Crear Dictamen"
                                                   href="{{ path('comision_dictamen_new', {id: giro.proyectoBae.expediente.id}) }}">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            {% endif %}
                                        {% endif %}

                                        {% if giro.cabecera and 'obras' in app.user.persona.cargoPersona.first.comision.nombre|lower %}
                                            <a class="btn btn-default" data-toggle="tooltip" title="Girar a Finalizado"
                                               href="{{ path('comision_girar_finalizado', {id: giro.id}) }}"
                                               onclick="return confirm('¿Está seguro que desea girar este expediente a Finalizado?');">
                                                <i class="fas fa-check-circle"></i>
                                            </a>
                                        {% endif %}
                                        {# <a class="btn btn-default" target="_blank" #}
                                        {# href="{{ path('expediente_imprimir_caratula', {id: expediente.id}) }}"> #}
                                        {# <i class="fa fa-print"></i> #}
                                        {# </a> #}
                                    </td>
                                </tr>
                            {% endif %}

                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        {# display navigation #}
        <div class="col-md-12 text-center">
            <div class="navigation">
                {{ knp_pagination_render(giros) }}
            </div>
        </div>
    </div>
{% endblock %}
