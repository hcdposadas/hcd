{% extends 'base.html.twig' %}

{% block title %}Nueva No Conformidad{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Nueva No Conformidad</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.area) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.empleado) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.origen) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.categoria) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            {{ form_row(form.requisito) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            {{ form_row(form.imagenFile) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.documentoFile) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-primary">Guardar</button>
                            <a href="{{ path('no_conformidad_index') }}" class="btn btn-default">Volver al listado</a>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('.select2').select2();
        });
    </script>
{% endblock %} 