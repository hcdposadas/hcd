{% extends 'base.html.twig' %}
{% block title %}
    Seguimiento Expediente: {{ expediente }}
{% endblock title %}

{% block contentHeader %}
    <section class="content-header">
        <h1>
            Expediente {{ expediente }}
            <small>Seguimientos</small>
        </h1>
    </section>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">

            <div class="timeline">
                <div class="time-label">
                    <span class="bg-red">
                            {{ expediente.fecha | date('d/m/Y') }}
                        </span>
                </div>

                {% for giro in giros %}
                    <div>
                        <i class="fa fa-map-signs bg-blue"></i>

                        <div class="timeline-item">
                                <span class="time"><i
                                            class="fa fa-clock-o"></i> {{ giro.fechaGiro | date('d/m/Y') }}</span>

                            {# si es giro administrativo #}
                            {% if attribute(giro, 'areaDestino') is defined %}
                                <h3 class="timeline-header">
                                    <a>{{ giro.areaDestino }}</a> {{ giro.texto }}</h3>
                                {% if is_granted('ROLE_MESA_ENTRADA') %}
                                    <div class="timeline-footer">
                                        <a class="btn btn-default btn-xs" target="_blank"
                                           href="{{ path('expediente_imprimir_giro', {id: expediente.id, giroId: giro.id, tipoExpediente: 'administrativo'}) }}">
                                            <i class="fas fa-print"></i>
                                        </a>
                                    </div>
                                {% endif %}
                            {% endif %}
                            {# si es giro administrativo #}

                            {# si es giro comision #}
                            {% if attribute(giro, 'comisionDestino') is defined %}
                                {% set cambioCabecera = giro.proyectoBae and giro.proyectoBae.esCambioCabecera %}

                                {% if cambioCabecera %}
                                    {% set sesionCambio = giro.proyectoBae.boletinAsuntoEntrado.sesion %}
                                    <h3 class="timeline-header">
                                        <strong>Cambio de cabecera</strong> —
                                        {% if giro.proyectoBae.comisionCabeceraAnterior %}
                                            de {{ giro.proyectoBae.comisionCabeceraAnterior }} a
                                        {% else %}
                                            a
                                        {% endif %}
                                        <a><strong>{{ giro.comisionDestino }}</strong></a>
                                        ({{ sesionCambio }} - {{ sesionCambio.fecha | date('d/m/Y') }})
                                        {% if not giro.proyectoBae.comisionCabeceraAnterior %}
                                            (sin cabecera anterior)
                                        {% endif %}
                                    </h3>
                                {% else %}
                                    <h3 class="timeline-header"><a>{{ giro.comisionDestino }}</a> {{ giro.texto }}
                                        {% if giro.proyectoBae and giro.proyectoBae.boletinAsuntoEntrado and giro.proyectoBae.boletinAsuntoEntrado.sesion %}
                                            ({{ giro.proyectoBae.boletinAsuntoEntrado.sesion }} - {{ giro.proyectoBae.boletinAsuntoEntrado.sesion.fecha | date ('d/m/Y') }})
                                        {% endif %}
                                        {% if giro.cabecera %}  -
                                            <span class="text-primary">Comisión de Cabecera</span>
                                        {% endif %}
                                    </h3>
                                {% endif %}

                                {% if is_granted('ROLE_MESA_ENTRADA') %}
                                    <div class="timeline-footer">
                                        {% if cambioCabecera %}
                                            <a class="btn btn-default btn-xs" target="_blank"
                                               href="{{ path('giros_comision_imprimir', {id: giro.proyectoBae.id}) }}">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        {% else %}
                                            <a class="btn btn-default btn-xs" target="_blank"
                                               href="{{ path('expediente_imprimir_giro', {id: expediente.id, giroId: giro.id, tipoExpediente: 'legislativo'}) }}">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endif %}
                            {# si es giro comision #}
                        </div>
                    </div>
                {% endfor %}


            </div>
        </div>
        <!-- /.col -->
    </div>
    <div class="row">
        <div class="col-md-12">
            {% if referer is defined %}
                <a href="{{ referer }}" class="btn btn-default">Volver</a>
            {% else %}
                <a href="{{ path('expediente_index') }}" class="btn btn-default">Volver</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
