{% extends 'base.html.twig' %}
{% block title %}
    Giros
{% endblock title %}
{% block body %}

    {% if is_granted('ROLE_LEGISLATIVO') %}
        <a class="btn btn-default" href="{{ path('giros_comisiones_index') }}">Volver</a>
    {% endif %}

    <h1>Editar Giros</h1>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Expediente {{ expediente }}</h3>
        </div>
        <div class="card-body">

            {{ form_start(edit_form) }}
            <div class="row">
                <div class="col-md-3">
                    <label class="control-label">Tipo de Proyecto</label>
                    <div>
                        {{ expediente.tipoProyecto }}
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="control-label">Fecha</label>
                    <div>
                        {{ expediente.fecha | date('d/m/Y') }}
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <h4>Seguimiento completo del expediente</h4>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered table-striped">
                            <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Destino</th>
                                <th>Sesión</th>
                                <th>Orden</th>
                                <th>Cabecera</th>
                                <th>Texto</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in giros_timeline %}
                                {% set giro = item.giro %}
                                <tr>
                                    <td>{% if giro.fechaGiro %}{{ giro.fechaGiro|date('d/m/Y') }}{% endif %}</td>
                                    <td>{% if item.tipo == 'administrativo' %}Administrativo{% else %}Comisión{% endif %}</td>
                                    <td>
                                        {% if item.tipo == 'administrativo' %}
                                            {{ giro.areaDestino }}
                                        {% else %}
                                            {{ giro.comisionDestino }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.sesion %}
                                            {{ item.sesion }} - {{ item.sesion.fecha|date('d/m/Y') }}
                                        {% endif %}
                                    </td>
                                    <td>{% if item.tipo != 'administrativo' %}{{ giro.orden }}{% endif %}</td>
                                    <td>
                                        {% if item.tipo != 'administrativo' %}
                                            {% if giro.cabecera %}Sí{% else %}No{% endif %}
                                        {% endif %}
                                    </td>
                                    <td>{{ giro.texto }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Este expediente no tiene giros cargados.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <h4>Editar y agregar giros del expediente</h4>
                    {{ form_row(edit_form.giros) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Guardar</button>
                </div>
            </div>

            <div class="d-none">
                {{ form_end(edit_form) }}
            </div>


        </div>
    </div>

    {% if is_granted('ROLE_LEGISLATIVO') %}
        <a class="btn btn-default" href="{{ path('giros_comisiones_index') }}">Volver</a>
    {% endif %}


{% endblock %}
{% block javascripts %}
    <script>

        {% if is_granted('ROLE_LEGISLATIVO') %}
        $(document).on('change', '.comision_cabecera', function () {
            $('.comision_cabecera').not(this).prop('checked', false);
        });
        {% endif %}
    </script>
{% endblock javascripts %}
