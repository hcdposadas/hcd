{% extends 'base.html.twig' %}
{% block title %}
    Cargar Extracto
{% endblock title %}
{% block body %}
    <div class="row mb-3">
        <div class="col-md-12">
            <a class="btn btn-default" href="{{ path('expedientes_legislativos_index') }}"> Volver</a>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Expediente</h3>
        </div>
        <div class="card-body">
                           <a class="btn btn-default mb-4" target="_blank"
                       href="{{ path('imprimir_proyecto_firmado', {id: expediente.id}) }}">
                        <i class="fa fa-print"></i> Imprimir Proyecto Firmado
                    </a>
            {{ form_start(form) }}
                            <div class="col-md-4">
                                {{ form_row(form.expediente) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.letra) }}
                            </div>
                        <div>
            {{ form_row(form.extracto) }}
            </div>
            <div class="row m-t-1">
                <div class="col-md-12">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Guardar</button>
                </div>
            </div>
            <div class="d-none">
                {{ form_end(form) }}
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <a class="btn btn-default" href="{{ path('expedientes_legislativos_index') }}"> Volver</a>
        </div>
    </div>

{% endblock body %}
